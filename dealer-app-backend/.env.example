# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on. The frontend expects http://localhost:4000/api
PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# true = serve mock data from src/mocks (no IDEP platform needed)
USE_MOCKS=true

# IDEP Integration Layer (SRS sections 2.5 and 4.4)
API_GATEWAY_URL=
EVENT_BUS_CONNECTION=

# Dealer identity via the manufacturer's identity provider (OAuth2 / OIDC)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Secret used to sign the app's session cookie
SESSION_SECRET=
