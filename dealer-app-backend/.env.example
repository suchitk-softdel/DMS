# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on. The frontend's dev server proxies /api here.
PORT=4000
NODE_ENV=development

# SQLite database file, relative to this folder. Copied from prisma/demo.db on first start.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Any long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty in development, a random one is used and logins reset on restart.
SESSION_SECRET=
SESSION_TTL_HOURS=8

# --- Later: IDEP platform (SRS 2.5 and 4.4), replaces the local database ---
# API_GATEWAY_URL=
# EVENT_BUS_CONNECTION=
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
