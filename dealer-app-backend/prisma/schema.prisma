// Database schema for the Dealer App backend.
//
// SQLite for development and demos. Per SRS v1.0 section 7 the production app
// reads from the IDEP Unified Dealer Data Layer instead; this database stands
// in for it until the platform APIs exist. To move to PostgreSQL, change the
// provider below and the driver adapter in src/db/prisma.js.
//
// Status / stage / type fields are plain strings because SQLite has no enums.
// The allowed values are listed in src/constants/domain.js.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Manufacturer, dealers, users and access
// ---------------------------------------------------------------------------

// The OEM whose dealer network uses the app. Every dealer belongs to one.
model Manufacturer {
  id            String @id
  name          String
  headquarters  String
  productLines  String // JSON array, e.g. ["Air Conditioners","Furnaces"]
  warrantyYears Int // standard parts warranty on equipment

  dealers            Dealer[]
  users              User[] // manufacturer staff, e.g. the order desk that approves dealer orders
  healthScoreWeights HealthScoreWeight[]
}

// Health Score component weights, set per manufacturer (FR-D360-6). A
// Manufacturer Administrator changes them here; no code change is needed.
// Without rows, the defaults in src/constants/domain.js are used.
model HealthScoreWeight {
  manufacturerId String
  component      String // revenueGrowth | orderVelocity | warrantyCompliance | trainingCompletion
  weight         Float // share of the score, e.g. 0.3 (the weights are normalised, so they need not add up to 1)

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@id([manufacturerId, component])
}

model Dealer {
  id                String   @id
  manufacturerId    String
  name              String
  city              String
  state             String
  region            String
  tier              String // Platinum | Gold | Silver
  status            String // active | pending | onHold
  territoryCoverage Float // 0..1 share of the assigned territory served (FR-D360-1)
  latitude          Float? // dealer location for the manufacturer's map (demo: city centre)
  longitude         Float?
  createdAt         DateTime @default(now()) // date the dealer joined the network

  manufacturer      Manufacturer           @relation(fields: [manufacturerId], references: [id])
  users             User[]
  customers         Customer[]
  orders            Order[]
  sales             Sale[]
  dealerSales       DealerSale[]
  inventory         Inventory[]
  claims            Claim[]
  registrations     WarrantyRegistration[]
  incentiveProgress IncentiveProgress[]
  opportunities     Opportunity[]
}

// Role permissions are data, not code, so the Manufacturer Administrator can
// change them without a release (SRS 2.3, 6.7).
model Role {
  id          String @id // dealer | manufacturer
  name        String
  permissions String // JSON array of module keys, e.g. ["home","orders"]

  users User[]
}

// A user works either for a dealer (dealerId) or for the manufacturer
// (manufacturerId, e.g. the order desk that approves dealer orders).
model User {
  id             String   @id
  name           String
  email          String   @unique
  passwordHash   String
  roleId         String
  dealerId       String?
  manufacturerId String?
  createdAt      DateTime @default(now())

  role             Role               @relation(fields: [roleId], references: [id])
  dealer           Dealer?            @relation(fields: [dealerId], references: [id])
  manufacturer     Manufacturer?      @relation(fields: [manufacturerId], references: [id])
  orders           Order[]            @relation("OrderCreator")
  reviewedOrders   Order[]            @relation("OrderReviewer")
  respondedOrders  Order[]            @relation("OrderResponder")
  trainingProgress TrainingProgress[]
  auditLogs        AuditLog[]
  dealerSales      DealerSale[]
}

// ---------------------------------------------------------------------------
// Catalogue and customers
// ---------------------------------------------------------------------------

model Product {
  id        String @id
  sku       String @unique
  name      String
  category  String // airConditioner | furnace | heatPump | airHandler | thermostat | indoorAirQuality | parts
  unitPrice Float
  unitCost  Float
  packSize  Int    @default(1)
  // Warranty length from the install date. Every product has 1 year by default;
  // change it per product here (no code change). Claims after it ends are refused.
  warrantyYears Int @default(1)

  orderItems    OrderItem[]
  sales         Sale[]
  dealerSales   DealerSale[]
  inventory     Inventory[]
  claims        Claim[]
  registrations WarrantyRegistration[]
}

model Customer {
  id       String @id
  dealerId String
  name     String
  type     String // residential | commercial
  city     String

  dealer        Dealer                 @relation(fields: [dealerId], references: [id])
  orders        Order[]
  claims        Claim[]
  registrations WarrantyRegistration[]
  opportunities Opportunity[]

  @@index([dealerId])
}

// ---------------------------------------------------------------------------
// Orders & Quotes (SRS 3.4)
// ---------------------------------------------------------------------------

model Order {
  id                  String    @id // e.g. ORD-100231 or QT-100232
  dealerId            String
  customerId          String? // past demo data only; new orders have no customer (dealer <-> manufacturer)
  createdById         String?
  type                String // quote | order
  // Orders: draft -> submitted (request with quantities, sent to the
  // manufacturer) -> approved (manufacturer approved and quoted catalogue
  // prices) or rejected -> accepted or declined by the dealer -> fulfilled by
  // the dealer. Quotes: draft -> submitted (sent to the customer) -> approved
  // (customer accepted).
  status              String // draft | submitted | approved | rejected | accepted | declined | fulfilled
  total               Float
  createdAt           DateTime
  updatedAt           DateTime
  // Orders: the manufacturer's decision (approve or reject).
  // Quotes: who recorded the customer's acceptance, and when.
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  // Quotes: proof of the customer's acceptance, recorded by the dealer.
  acceptanceMethod    String? // email | phone | signedCopy | inPerson
  acceptanceContact   String? // customer contact who accepted, e.g. "John Lee, Facilities Manager"
  acceptanceNote      String?
  // Orders: the dealer's answer to the manufacturer's quote.
  dealerRespondedById String?
  dealerRespondedAt   DateTime?
  declineReason       String?

  dealer            Dealer                 @relation(fields: [dealerId], references: [id])
  customer          Customer?              @relation(fields: [customerId], references: [id])
  createdBy         User?                  @relation("OrderCreator", fields: [createdById], references: [id])
  reviewedBy        User?                  @relation("OrderReviewer", fields: [reviewedById], references: [id])
  dealerRespondedBy User?                  @relation("OrderResponder", fields: [dealerRespondedById], references: [id])
  items             OrderItem[]
  registrations     WarrantyRegistration[]
  claims            Claim[]

  @@index([dealerId, createdAt])
  @@index([dealerId, status])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id])
  registrations WarrantyRegistration[]

  @@index([orderId])
}

// Monthly sales per dealer and product. AGGREGATE TABLE: never written by
// hand. src/services/aggregationService.js rebuilds it from fulfilled orders
// at seed time and after every order change, so it always matches the orders.
// Feeds revenue KPIs, trend charts and forecasting (SRS 3.1, 3.3, 3.5).
model Sale {
  id        Int    @id @default(autoincrement())
  dealerId  String
  productId String
  month     String // YYYY-MM
  units     Int
  revenue   Float
  cost      Float

  dealer  Dealer  @relation(fields: [dealerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([dealerId, productId, month])
  @@index([dealerId, month])
}

// One sale from the dealer to its customer (Place Orders screen). The dealer
// can only sell what it has on hand; each sale takes the units off its stock.
// basePrice is the manufacturer's price for the product at the time of sale;
// sellingPrice is what the dealer charged and must be higher.
// Kept apart from Sale (the revenue aggregate built from manufacturer orders).
model DealerSale {
  id           Int      @id @default(autoincrement())
  dealerId     String
  productId    String
  quantity     Int
  basePrice    Float
  sellingPrice Float
  soldById     String?
  createdAt    DateTime @default(now())

  dealer  Dealer  @relation(fields: [dealerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  soldBy  User?   @relation(fields: [soldById], references: [id])

  @@index([dealerId, createdAt])
}

// ---------------------------------------------------------------------------
// Inventory (SRS 3.5)
// ---------------------------------------------------------------------------

model Inventory {
  id           Int      @id @default(autoincrement())
  dealerId     String
  productId    String
  onHand       Int
  onOrder      Int
  reorderPoint Int
  updatedAt    DateTime

  dealer  Dealer  @relation(fields: [dealerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([dealerId, productId])
}

// ---------------------------------------------------------------------------
// Warranty & Claims (SRS 3.7)
// ---------------------------------------------------------------------------

// One row per installed equipment unit, traced back to the order line it was
// sold on: Order -> OrderItem -> WarrantyRegistration -> Claim.
model WarrantyRegistration {
  id           String   @id
  dealerId     String
  orderId      String
  orderItemId  Int
  productId    String
  customerId   String? // past demo data only; new orders have no customer (dealer <-> manufacturer)
  serialNumber String   @unique
  installDate  DateTime
  createdAt    DateTime

  dealer    Dealer    @relation(fields: [dealerId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  claims    Claim[]

  @@index([dealerId])
  @@index([orderId])
}

// A claim is always against a registered unit, so it links to the
// registration and to the original order.
model Claim {
  id             String    @id // e.g. CLM-20431
  dealerId       String
  registrationId String
  orderId        String
  productId      String
  customerId     String? // past demo data only; new orders have no customer (dealer <-> manufacturer)
  serialNumber   String
  amount         Float
  description    String
  stage          String // submitted | underReview | approved | reimbursed | rejected
  filedAt        DateTime
  stageChangedAt DateTime // "Age" on the kanban card = days since this (FR-WAR-3)
  resolvedAt     DateTime?

  dealer       Dealer               @relation(fields: [dealerId], references: [id])
  registration WarrantyRegistration @relation(fields: [registrationId], references: [id])
  order        Order                @relation(fields: [orderId], references: [id])
  product      Product              @relation(fields: [productId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])

  @@index([dealerId, stage])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Incentives & Training (SRS 3.6)
// ---------------------------------------------------------------------------

model IncentiveProgram {
  id              String   @id
  name            String
  description     String
  metric          String // revenue | units | trainingHours
  productCategory String? // for metric "units": which category counts
  startDate       DateTime
  endDate         DateTime
  milestones      String // JSON array: [{ "target": 500000, "payout": 5000 }, ...]

  progress IncentiveProgress[]
}

// AGGREGATE TABLE: rebuilt by src/services/aggregationService.js from sales
// and completed training, never written by hand.
model IncentiveProgress {
  id        Int    @id @default(autoincrement())
  dealerId  String
  programId String
  current   Float // progress so far, in the program's metric
  earned    Float // payout earned so far

  dealer  Dealer           @relation(fields: [dealerId], references: [id])
  program IncentiveProgram @relation(fields: [programId], references: [id])

  @@unique([dealerId, programId])
}

model TrainingCourse {
  id            String    @id
  title         String
  category      String // product | installation | service | sales | safety
  durationHours Float
  certification String? // certification earned on completion, if any
  scheduledAt   DateTime? // set for live events and webinars (FR-INC-5)

  progress TrainingProgress[]
}

model TrainingProgress {
  id            Int       @id @default(autoincrement())
  userId        String
  courseId      String
  completionPct Int
  completedAt   DateTime?

  user   User           @relation(fields: [userId], references: [id])
  course TrainingCourse @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ---------------------------------------------------------------------------
// Sales Coach (SRS 3.8)
// ---------------------------------------------------------------------------

model Opportunity {
  id           String   @id
  dealerId     String
  customerId   String
  title        String
  need         String
  budget       Float
  decisionDate DateTime
  stage        String // new | qualified | proposal | negotiation | won | lost
  competitor   String?
  createdAt    DateTime

  dealer   Dealer   @relation(fields: [dealerId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([dealerId, stage])
}

// ---------------------------------------------------------------------------
// Audit log (SRS 6.2: all write actions are audit-logged)
// ---------------------------------------------------------------------------

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  action    String // e.g. auth.login, order.create, claim.submit
  entity    String?
  entityId  String?
  details   String? // JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}
