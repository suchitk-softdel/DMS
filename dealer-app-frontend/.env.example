# Copy this file to .env and adjust as needed. Every value is optional.

# Development default is false: the app calls dealer-app-backend, which must be
# running (cd ../dealer-app-backend && npm run dev).
# Set to true to use the small hardcoded data in src/data without a backend.
# VITE_USE_MOCK_DATA=true

# Base URL of the backend API. In development the default '/api' is proxied
# to http://localhost:4000 by vite.config.js, so you rarely need to set this.
# VITE_API_BASE_URL=/api

# Google Maps JavaScript API key for the dealer map on Order Approvals.
# Without it the map still shows, greyed out and marked "for development
# purposes only". Restrict the key to your site's address in Google Cloud.
# VITE_GOOGLE_MAPS_API_KEY=
